# Chave em https://console.x.ai — nunca commite o arquivo .env
XAI_API_KEY=

# grok-4.5 (texto+visão) — não troque sem motivo
JARVIS_MODEL=grok-4.5

# Idioma da voz e do reconhecimento
JARVIS_LANG=pt-BR

# Voz xAI TTS (altair = sóbria)
JARVIS_VOICE=altair

# Máximo de passos autônomos por ordem
JARVIS_MAX_STEPS=20
