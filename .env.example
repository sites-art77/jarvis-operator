# Nunca commite este arquivo preenchido.
# NVIDIA (visão da tela + raciocínio/ferramentas): https://build.nvidia.com
NVIDIA_API_KEY=

# xAI opcional — voz (TTS/STT) e, se não houver NVIDIA, o cérebro Grok
XAI_API_KEY=

# auto | nvidia | xai   (auto usa NVIDIA se a chave existir)
JARVIS_PROVIDER=auto

# Padrões NVIDIA. Só mude se souber o id no catálogo NIM.
# JARVIS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# JARVIS_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

JARVIS_LANG=pt-BR
JARVIS_VOICE=altair
JARVIS_MAX_STEPS=20
